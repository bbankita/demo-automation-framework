# Copy to .env (git-ignored) for local runs. Real environment variables take precedence.
# Blank values are ignored, so the defaults in config/<env>.json still apply.
CONDUIT_API_BASE_URI=http://localhost:3001/api
UI_BASE_URL=http://localhost:3001

# Set the following environment variables with existing test userCredentials. The userCredentials must already exist in the database. If the userCredentials does not exist, the test will fail.
# If no test userCredentials is provided, the test will use default userCredentials that exists.
TEST_USER_EMAIL=
TEST_USER_USERNAME=
TEST_USER_PASSWORD=

# Must match the Conduit container's JWT secret. Used to sign expired/forged tokens in negative tests.
CONDUIT_JWT_KEY=

#DB
CONDUIT_DB_URL=jdbc:postgresql://localhost:5432/conduit
CONDUIT_DB_USERNAME=
CONDUIT_DB_PASSWORD=
